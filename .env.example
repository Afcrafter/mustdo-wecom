# 复制为 .env.local（本地）或在 Vercel → Settings → Environment Variables 填写。
# 不要把真实值提交进 Git。

# —— 企业微信自建应用（管理后台 → 应用管理 → 自建）——
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# 接收消息「Token / EncodingAESKey」，和后台填的必须完全一致
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# 可信域名校验文件：后台下载 WW_verify_xxxx.txt 后，文件名和文件内容分别填在这里
WECOM_VERIFY_FILENAME=
WECOM_VERIFY_CONTENT=

# 应用主页公网地址，不要末尾斜杠。例：https://mustdo-xxx.vercel.app
APP_BASE_URL=

# 本地/单人调试时可填自己的企业微信 userid，跳过 OAuth
WECOM_DEFAULT_USERID=

# Vercel Cron / 外部定时器调用 /api/tick 时带上：Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Vercel Storage 里创建 KV（Upstash Redis）后会自动出现这两个
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
